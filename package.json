{
  "name": "tallypress",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 9000",
    "build": "next build",
    "start": "next start -p 9000",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-dev-shop.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "shop:connect": "tsx scripts/connect-shop.ts",
    "shop:import-range": "tsx scripts/import-range.ts",
    "shop:images": "tsx scripts/sync-images.ts",
    "shop:sync-full": "tsx scripts/sync-full.ts",
    "shop:rebuild-costs": "tsx scripts/rebuild-costs.ts",
    "shop:returns": "tsx scripts/sync-returns.ts",
    "shop:restart": "tsx scripts/restart.ts",
    "shop:estimate-restocks": "tsx scripts/estimate-restocks.ts",
    "shop:estimate-payments": "tsx scripts/estimate-payments.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }

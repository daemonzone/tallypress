# Docker dev stack
WP_PORT=9080
WP_DB_PORT=9306
TALLYPRESS_DB_PORT=9432

# App
DATABASE_URL=postgres://tallypress:tallypress@localhost:9432/tallypress
# The shop every request is scoped to until real multi-shop routing/auth exists.
DEFAULT_SHOP_ID=00000000-0000-4000-8000-000000000001
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=dev-cron-secret

# Used only by `npm run db:seed` to point the dev shop at the Docker WooCommerce.
DEV_WOO_URL=http://localhost:9080
DEV_WOO_CONSUMER_KEY=ck_tallypress_dev_0001
DEV_WOO_CONSUMER_SECRET=cs_tallypress_dev_0001
